{
  "version": 1,
  "note": "Phrase patterns for internal process wording that must not be published from this repository. Each allowlist entry names one pattern id, one file glob and the exact matched text (or a regex over it) with a reason; it covers product wording only. A pattern with knownFrom ignores tokens that this repository itself defines. Allowlist regexes are written so that their own text does not match the patterns.",
  "patterns": [
    {
      "id": "approval-wording",
      "re": "(?<![A-Za-z0-9])owner(?:[*_`~()\\[\\]]*(?:['’]|&#x?0*27;|&#39;|&apos;|&rsquo;|&#8217;|\\\\u2019|\\\\u0027)s)?[*_`~()\\[\\]]*(?:[\\s:;,/—–-]|&nbsp;|&#160;|&#xa0;)+[*_`~()\\[\\]]*(?:\\w+(?:[\\s:;,/—–-]|&nbsp;|&#160;|&#xa0;)+[*_`~()\\[\\]]*){0,2}(?:OK|decision|sign-?off|said|approv\\w*|decid\\w*|confirm\\w*|sign(?:s|ed)?\\s+off|accept\\w*|agree\\w*)\\b",
      "flags": "i",
      "why": "Approval wording attributed to a project owner (also with Markdown emphasis, separators and other verbs)"
    },
    {
      "id": "person-approval",
      "re": "\\b(?:approv\\w*|sign(?:s|ed)?\\s+off|decid\\w*|confirm\\w*|accept\\w*)\\s+(?:by|from|per)\\s+(?:Oleg|(?:the\\s+|our\\s+)?(?:project\\s+|repo\\s+|repository\\s+)?owner)\\b",
      "flags": "i",
      "why": "Approval attributed to a named person or the owner"
    },
    {
      "id": "person-verb",
      "re": "\\bOleg(?:(?:['’]|&#x?0*27;|&#39;|&apos;|&rsquo;|&#8217;|\\\\u2019|\\\\u0027)s)?(?:\\s+\\p{L}+)?(?:[\\s:;,/—–-]|&nbsp;|&#160;|&#xa0;)+(?:approv\\w*|decid\\w*|said|sign(?:s|ed)?\\s+off|OK|decision|confirm\\w*|agree\\w*|reject\\w*|asked|wants?)\\b",
      "flags": "iu",
      "why": "Statement attributed to a named person"
    },
    {
      "id": "cyrillic",
      "re": "\\p{Script=Cyrillic}+",
      "flags": "u",
      "why": "Text in a language this repository does not publish in: internal discussion written in it must not reach the public tree"
    },
    {
      "id": "question-round",
      "re": "\\bquiz(?:zes)?\\s*(?:#|№)?\\d+\\b|\\bquiz(?:zes)?\\s+(?:round|answer|decision|result)s?\\b|\\b(?:per|from|after|in|via)\\s+(?:the\\s+)?quiz\\b",
      "flags": "i",
      "why": "Question round used as a review step"
    },
    {
      "id": "issue-key",
      "re": "\\b\\d[A-Z]{1,3}-\\d+\\b",
      "flags": "",
      "why": "Key of an internal work item"
    },
    {
      "id": "issue-branch",
      "re": "\\b\\d[a-z]{1,3}-\\d+-[a-z][\\w-]*",
      "flags": "i",
      "why": "Branch name that starts with a work item key"
    },
    {
      "id": "tracker-link",
      "re": "\\blinear\\.app\\b(?:/[\\w-]+)*",
      "flags": "i",
      "why": "Link to an internal tracker"
    },
    {
      "id": "plan-step",
      "re": "\\bplan step\\b",
      "flags": "i",
      "why": "Internal process stage label"
    },
    {
      "id": "review-round",
      "re": "\\b(?:review|PR) rounds?\\b",
      "flags": "i",
      "why": "Internal review process label"
    },
    {
      "id": "pull-request-number",
      "re": "\\bPRs?[ \\t]*#\\d+\\b|\\bPR[ \\t-]\\d{1,4}\\b(?![.\\d])",
      "flags": "",
      "why": "Pull request shorthand such as PR plus a number"
    },
    {
      "id": "do-not-merge",
      "re": "\\bdo not merge\\b",
      "flags": "i",
      "why": "Merge instruction"
    },
    {
      "id": "internal-id",
      "re": "\\b(?:QF|BP|PUB|RETRO|DELIVERY)-(?:[A-Z0-9]{1,12}-){0,3}\\d+\\b",
      "flags": "",
      "why": "Identifier of an internal rule or decision log entry"
    },
    {
      "id": "rule-id",
      "re": "\\b(?:US|UR|KR|XP|DEC|TY|J|LK|NR|DS)-\\d+[a-z]?\\b",
      "flags": "",
      "why": "Rule identifier that this repository does not define",
      "knownFrom": [
        "canon/public",
        "scripts/rules"
      ]
    }
  ],
  "allowlist": [
    {
      "id": "approval-wording",
      "file": "canon/**",
      "re": "own[e]r(?:['’]s)?[ ]decision|own[e]r-approved(?:[ ]decision)?",
      "reason": "Wording of published rule texts: owner is a generic role name in a public agent rule"
    },
    {
      "id": "approval-wording",
      "file": "skills/audit/references/design-system-integrity.md",
      "re": "own[e]r[ ](?:visual[ ])?(?:decision|acceptance)",
      "reason": "Wording of a published skill reference: owner is a generic role name"
    },
    {
      "id": "rule-id",
      "file": "scripts/**",
      "re": "DS-2[b]",
      "reason": "Sub-rule that the retired combined rule points to, named in the shipped detector and its tests"
    },
    {
      "id": "approval-wording",
      "file": "skills/audit/SKILL.md",
      "re": "own[e]r[ ]acceptance",
      "reason": "Wording of the published skill: owner is a generic role name"
    }
  ]
}
